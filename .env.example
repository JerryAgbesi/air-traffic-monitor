# Copy to .env and fill in. Never commit .env.
# Create the API client on https://opensky-network.org -> Account -> API client
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=opensky.states.raw

# Polling interval in seconds (75 s keeps a France-sized box within the free daily credits)
POLL_SECONDS=75

# Bounding box: metropolitan France
LAMIN=41.3
LOMIN=-5.2
LAMAX=51.1
LOMAX=9.6
