# Copy to .env (never commit it).  Used by the producer (node6) and by
# deploy/submit.sh (node1).

# OpenSky API client (opensky-network.org -> Account -> API client)
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

KAFKA_BOOTSTRAP=node2:9092,node3:9092,node4:9092
KAFKA_TOPIC=opensky.states.raw
POLL_SECONDS=75
LAMIN=41.3
LOMIN=-5.2
LAMAX=51.1
LOMAX=9.6

# TimescaleDB on node6
TSDB_URL=jdbc:postgresql://node6:5432/opensky
TSDB_USER=spark_writer
TSDB_PASSWORD=change-me
# producer metrics -> pipeline_health (leave empty to disable)
TSDB_DSN=host=node6 dbname=opensky user=spark_writer password=change-me
