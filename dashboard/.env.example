# Dashboard Environment Configuration
# Copy to .env and fill in values

# InfluxDB (worker5)
INFLUX_URL=http://worker5:8086
INFLUX_ORG=esilv
INFLUX_BUCKET=air_traffic
INFLUX_TOKEN=your-influx-token-here

# Kafka (for forecast consumption - optional, dashboard reads from InfluxDB)
KAFKA_BOOTSTRAP=worker2:9092,worker3:9092,worker4:9092
FORECAST_TOPIC=opensky.forecast.30min

# Flask
FLASK_DEBUG=false
PORT=5000