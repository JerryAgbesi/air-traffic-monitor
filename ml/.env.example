# ML Module Environment Configuration
# Copy to .env and fill in values

# HDFS Paths
CURATED_PATH=/data/curated/opensky_states
MODEL_PATH=/models/airborne_forecaster
FEATURES_PATH=/tmp/airborne_features

# Kafka
KAFKA_BOOTSTRAP=worker2:9092,worker3:9092,worker4:9092
FORECAST_TOPIC=opensky.forecast.30min

# Forecasting
FORECAST_MODEL=random_forest
LOOKBACK_HOURS=4

# Spark (set by spark-submit)
# SPARK_HOME=/opt/spark